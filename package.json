{
  "name": "token-monitor-analytics",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.21.0"
  },
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "routes": "tsr generate",
    "typecheck": "npm run routes && tsc -p tsconfig.json && tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.tests.json",
    "lint": "eslint backend frontend/src tests scripts --ignore-pattern frontend/src/routeTree.gen.ts",
    "format": "prettier --write backend frontend/src tests scripts *.json *.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=.env dist/backend/main.js",
    "test:core": "node scripts/core-tests.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:repeat": "npm run build && playwright test --workers=4 --repeat-each=3",
    "verify": "node scripts/verify.mjs",
    "db:backup": "node --experimental-strip-types --env-file-if-exists=.env scripts/backup.ts",
    "db:check": "node --experimental-strip-types --env-file-if-exists=.env scripts/check-db.ts",
    "package": "npm run verify && node scripts/package.mjs"
  },
  "dependencies": {
    "@fastify/static": "10.1.4",
    "@mantine/core": "8.3.18",
    "@mantine/hooks": "8.3.18",
    "@tanstack/react-query": "5.103.1",
    "@tanstack/react-router": "1.170.38",
    "@trpc/client": "11.19.0",
    "@trpc/server": "11.19.0",
    "fastify": "5.12.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.63.0",
    "@tanstack/router-cli": "1.167.38",
    "@tanstack/router-plugin": "1.168.40",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.5.0",
    "jsdom": "26.1.0",
    "prettier": "3.9.8",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  }
}
