<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="token-monitor-analytics.exe"
        Arguments=""
        InstallLocation="C:\Program Files\nuits.jp\Token Monitor Analytics">
    </Installer>
    <PackageInformation
        PackageName="Token Monitor Analytics"
        PackageDisplayName="Token Monitor Analytics"
        PublisherName="CN=nuits.jp"
        PublisherDisplayName="nuits.jp"
        Version="0.1.0.0"
        PackageDescription="Local-first analytics for Token Monitor hubs">
        <Capabilities>
            <Capability Name="runFullTrust" />

        </Capabilities>
        <Applications>
            <Application
                Id="jp.nuits.token-monitor-analytics"
                Description="Local-first analytics for Token Monitor hubs"
                DisplayName="Token Monitor Analytics"
                ExecutableName="token-monitor-analytics.exe"
                EntryPoint="Windows.FullTrustApplication">

            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Token Monitor Analytics</DisplayName>
            <PublisherDisplayName>nuits.jp</PublisherDisplayName>
            <Description>Local-first analytics for Token Monitor hubs</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="token-monitor-analytics.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
