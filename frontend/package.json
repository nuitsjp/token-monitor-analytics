{
  "name": "token-monitor-analytics-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build:dev": "tsc && vite build --minify false --mode development",
    "build": "tsc && vite build --mode production",
    "lint": "eslint . --max-warnings=0 --report-unused-disable-directives",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test e2e/window-routing.spec.ts",
    "test:e2e:screenshots": "playwright test e2e/showcase-screenshots.spec.ts"
  },
  "dependencies": {
    "@fluentui/react-components": "9.74.7",
    "@fluentui/react-icons": "2.0.338",
    "@tanstack/react-query": "5.102.3",
    "@wailsio/runtime": "3.0.0-beta.12",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hook-form": "7.86.0",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.55.1",
    "@testing-library/jest-dom": "6.8.0",
    "@testing-library/react": "16.3.0",
    "@testing-library/user-event": "14.6.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.0",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.11.1",
    "eslint": "9.39.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.4",
    "jsdom": "26.1.0",
    "keyborg": "2.14.1",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
