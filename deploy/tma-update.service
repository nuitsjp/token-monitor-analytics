[Unit]
Description=Token Monitor Analytics update runner (oneshot)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/var/lib/tma-deploy/updater
ExecStart=/var/lib/tma-deploy/updater/node --experimental-strip-types /var/lib/tma-deploy/updater/tools/update-runner.mjs
Environment=PATH=/var/lib/tma-deploy/updater/node-runtime/bin:%h/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
UMask=0077
NoNewPrivileges=true
