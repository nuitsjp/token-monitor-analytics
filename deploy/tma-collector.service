[Unit]
Description=Token Monitor Collector (Go SSE receiver)
Wants=network-online.target tma-analytics.service
After=network-online.target tma-analytics.service
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=tma-collector
Group=tma-collector
WorkingDirectory=/opt/token-monitor-analytics
EnvironmentFile=/etc/token-monitor-analytics/collector.env
ExecStart=/opt/token-monitor-analytics/tma-collector -config /etc/token-monitor-analytics/collector.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=30
StateDirectory=tma-collector
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
