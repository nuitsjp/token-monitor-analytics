[Unit]
Description=Token Monitor Analytics (native Node.js + SQLite)
After=network.target
StartLimitIntervalSec=120
StartLimitBurst=6

[Service]
Type=simple
User=tma-analytics
Group=tma-analytics
WorkingDirectory=/opt/token-monitor-analytics/current
Environment=NODE_ENV=production
EnvironmentFile=/var/lib/tma-deploy/config/analytics.env
ExecStart=/opt/token-monitor-analytics/current/node --experimental-strip-types /opt/token-monitor-analytics/current/analytics/runtime/server.mjs --config /var/lib/tma-deploy/config/analytics.json
Restart=on-failure
RestartSec=10
TimeoutStopSec=15
StateDirectory=tma-analytics
StateDirectoryMode=0700
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
