# /etc/token-monitor-analytics/collector.env (root-owned, chmod 600)
# These are Hub SHARED SECRETS, not Cloudflare account/deployment API tokens.
TMA_HUB_A_SECRET=REPLACE_WITH_HUB_A_SHARED_SECRET
TMA_HUB_B_SECRET=REPLACE_WITH_HUB_B_SHARED_SECRET
TMA_INGEST_TOKEN=REPLACE_WITH_ANALYTICS_INGEST_TOKEN
