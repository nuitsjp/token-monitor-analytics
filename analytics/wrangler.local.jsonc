// LOCAL ONLY: never deploy this file.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "token-monitor-analytics-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "token-monitor-analytics",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "LIVE",
        "class_name": "LiveRoom"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "LiveRoom"
      ]
    }
  ],
  "vars": {
    "AUTH_MODE": "local",
    "INGEST_TOKEN": "demo-ingest-token-not-for-production"
  }
}
