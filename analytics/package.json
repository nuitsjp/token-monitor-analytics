{
  "name": "token-monitor-analytics-web", "version": "0.2.0", "private": true, "type": "module",
  "engines": {"node": ">=22.16"},
  "scripts": {
    "dev": "wrangler dev --config wrangler.local.jsonc --ip 127.0.0.1 --port 8787",
    "db:local": "wrangler d1 migrations apply DB --local --config wrangler.local.jsonc",
    "typecheck": "tsc --noEmit",
    "build:test": "tsc --outDir .test-build",
    "test": "npm run build:test && node --test test/*.test.mjs",
    "deploy": "wrangler deploy --config wrangler.jsonc",
    "db:remote": "wrangler d1 migrations apply DB --remote --config wrangler.jsonc"
  },
  "devDependencies": { "typescript": "5.8.3", "wrangler": "4.126.0" }
}
